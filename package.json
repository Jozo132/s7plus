{
  "name": "s7plus",
  "version": "0.5.0",
  "description": "Siemens S7Comm and S7CommPlus client, acquisition and proxy library for Node.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jozo132/s7plus.git"
  },
  "keywords": ["siemens", "s7", "s7comm", "s7commplus", "plc", "scada"],
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/lib.js"
    },
    "./worker": {
      "import": "./src/worker.js"
    }
  },
  "main": "./src/lib.js",
  "bin": {
    "s7plus": "src/index.js"
  },
  "files": [
    "src/",
    "public/",
    "config/default.json",
    "README.md",
    "CHANGELOG.md",
    "docs/",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "check-types": "tsc --project jsconfig.json --noEmit",
    "explore:production": "node src/plus-explore.js --live"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "node-snap7": "^1.0.9",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
