{
  "name": "s7plus",
  "version": "0.5.0",
  "description": "Siemens S7Comm and S7CommPlus client, acquisition and proxy library for Node.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jozo132/s7plus.git"
  },
  "keywords": [
    "siemens",
    "s7",
    "s7comm",
    "s7commplus",
    "plc",
    "scada"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/lib.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/lib.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./worker": {
      "import": {
        "types": "./dist/types/worker.d.ts",
        "default": "./src/worker.js"
      },
      "require": {
        "types": "./dist/types-cjs/worker.d.ts",
        "default": "./dist/worker.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/lib.d.ts",
  "bin": {
    "s7plus": "src/index.js"
  },
  "files": [
    "src/",
    "dist/",
    "public/",
    "config/default.json",
    "config/s7commplus-benchmark.json",
    "examples/",
    "README.md",
    "CHANGELOG.md",
    "docs/",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "prepare": "npm run build",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "check-types": "tsc --project jsconfig.json --noEmit",
    "explore:production": "node src/plus-explore.js --live"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
